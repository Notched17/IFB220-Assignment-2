# Copy this file to .env (in the project folder) and put in your own key.
# Never commit .env -- it is git-ignored.
API_KEY=your-ifb220-portal-key-here

# That is the ONLY required setting. Everything else (portal URL, API
# version, model deployments, topic, guardrail/context/timeout settings,
# cost rates, log folder) is preconfigured in app_config.json. Any of those
# can optionally be overridden with an environment variable, e.g.
#   TOPIC_CONFIG=topics/motor_vehicles.json
# (see ENV_OVERRIDES in src/config.py for the full list).
