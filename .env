# Copy this file to .env and fill in the real values. Never commit .env.

# --- Required: IFB220 Developer API Portal credentials ----------------
# Get these from the IFB220 Developer API Portal dashboard.
API_KEY=
# Full base URL INCLUDING the trailing "/openai/". The SDK appends
# "deployments/<CHAT_DEPLOYMENT>/chat/completions?api-version=..." per call.
AZURE_OPENAI_BASE_URL="https://qut-ai.azure-api.net/ifb220/openai/"
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# --- Model deployment names (should match the assignment brief) -------
CHAT_DEPLOYMENT=gpt-4.1-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Topic: point this at a different topics/*.json to retopic --------
TOPIC_CONFIG=topics/climbing.json

# --- Guardrail tuning (optional overrides) -----------------------------
# SIMILARITY_THRESHOLD=0.74
MAX_INPUT_CHARS=2000
CHECK_OUTPUT_TOPICALITY=true

# --- Context window management -----------------------------------------
MAX_CONTEXT_TURNS=6
MAX_CONTEXT_TOKENS=3000
SUMMARIZE_WITH_LLM=false

# --- Reliability ---------------------------------------------------------
REQUEST_TIMEOUT_S=20
MAX_RETRIES=3

# --- Cost estimation (fill in from the portal's actual pricing) --------
CHAT_COST_PER_1K_PROMPT=0.0
CHAT_COST_PER_1K_COMPLETION=0.0
EMBEDDING_COST_PER_1K=0.0

# --- Logging -------------------------------------------------------------
LOG_DIR=logs
